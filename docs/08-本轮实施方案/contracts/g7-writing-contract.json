{
  "contract_version": "1.0.0",
  "status": "proposed_not_implemented",
  "baseline_main_sha": "e328c56bb47d22e348850589e4dc9ddbad8d265e",
  "scope": "G7-01 contract freeze for working copy, selected rewrite, local apply, and explicit immutable-version commit",
  "source_format": "body_markdown with [[source:<source_id>]] markers",
  "selection_offsets": "zero-based UTF-16 code units; end exclusive; selected_text must exactly match the current work-copy range",
  "operation_contracts": [
    {
      "operation_id": "getWorkingCopy",
      "method": "GET",
      "path": "/projects/{projectId}/chapters/{chapterId}/working-copy",
      "response_schema": "WorkingCopy",
      "side_effect": "none",
      "authorization": ["current project read", "current authorization for every referenced source"]
    },
    {
      "operation_id": "saveWorkingCopy",
      "method": "PUT",
      "path": "/projects/{projectId}/chapters/{chapterId}/working-copy",
      "request_schema": "SaveWorkingCopyRequest",
      "response_schema": "WorkingCopy",
      "requires_idempotency_key": true,
      "side_effect": "create a mutable work-copy checkpoint only; never create a ChapterVersion",
      "authorization": ["current project write", "recheck every referenced source before write and replay"]
    },
    {
      "operation_id": "requestSelectedRewrite",
      "method": "POST",
      "path": "/projects/{projectId}/chapters/{chapterId}/rewrite-candidates",
      "request_schema": "SelectedRewriteRequest",
      "response_schema": "RewriteCandidate",
      "requires_idempotency_key": true,
      "side_effect": "create a candidate only; do not mutate the working copy or ChapterVersion",
      "authorization": ["current project write", "current authorization for every referenced source"]
    },
    {
      "operation_id": "getSelectedRewrite",
      "method": "GET",
      "path": "/projects/{projectId}/rewrite-candidates/{candidateId}",
      "response_schema": "RewriteCandidate",
      "side_effect": "none",
      "authorization": ["current project read", "recheck candidate source authorization; revoke returns no candidate text"]
    },
    {
      "operation_id": "applySelectedRewrite",
      "method": "POST",
      "path": "/projects/{projectId}/chapters/{chapterId}/rewrite-candidates/{candidateId}/apply",
      "request_schema": "ApplySelectedRewriteRequest",
      "response_schema": "WorkingCopy",
      "requires_idempotency_key": true,
      "side_effect": "replace only the bound selection in the working copy; never create a ChapterVersion",
      "authorization": ["current project write", "recheck every candidate source before apply and replay"]
    },
    {
      "operation_id": "commitWorkingCopy",
      "method": "POST",
      "path": "/projects/{projectId}/chapters/{chapterId}/working-copy/commit",
      "request_schema": "CommitWorkingCopyRequest",
      "response_schema": "CommittedChapterVersion",
      "requires_idempotency_key": true,
      "side_effect": "create exactly one immutable ChapterVersion from the persisted current working-copy revision, atomically advance the work-copy base to that version, increment its revision, and stale prior candidates",
      "authorization": ["current project write", "recheck every referenced source before commit and replay"]
    }
  ],
  "schemas": {
    "ReviewItem": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "origin_candidate_id": {"type": "string", "minLength": 1}
      },
      "required": ["id", "statement", "origin_candidate_id"],
      "additionalProperties": false
    },
    "WorkingCopy": {
      "type": "object",
      "properties": {
        "base_chapter_version_id": {"type": ["string", "null"]},
        "spec_revision": {"type": "integer", "minimum": 0},
        "working_copy_revision": {"type": "integer", "minimum": 1},
        "body_markdown": {"type": "string"},
        "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "review_items": {"type": "array", "items": {"$ref": "#/schemas/ReviewItem"}},
        "updated_at": {"type": "string", "format": "date-time"}
      },
      "required": ["base_chapter_version_id", "spec_revision", "working_copy_revision", "body_markdown", "source_ids", "review_items", "updated_at"],
      "additionalProperties": false
    },
    "SaveWorkingCopyRequest": {
      "type": "object",
      "properties": {
        "base_chapter_version_id": {"type": ["string", "null"]},
        "expected_spec_revision": {"type": "integer", "minimum": 0},
        "expected_working_copy_revision": {"type": "integer", "minimum": 0},
        "body_markdown": {"type": "string"},
        "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "required": ["base_chapter_version_id", "expected_spec_revision", "expected_working_copy_revision", "body_markdown", "source_ids"],
      "additionalProperties": false
    },
    "Selection": {
      "type": "object",
      "properties": {
        "start_utf16": {"type": "integer", "minimum": 0},
        "end_utf16": {"type": "integer", "minimum": 1},
        "selected_text": {"type": "string", "minLength": 1}
      },
      "required": ["start_utf16", "end_utf16", "selected_text"],
      "additionalProperties": false
    },
    "SelectedRewriteRequest": {
      "type": "object",
      "properties": {
        "base_chapter_version_id": {"type": ["string", "null"]},
        "expected_spec_revision": {"type": "integer", "minimum": 0},
        "expected_working_copy_revision": {"type": "integer", "minimum": 1},
        "selection": {"$ref": "#/schemas/Selection"},
        "instruction": {"type": "string", "minLength": 1, "maxLength": 2000},
        "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "required": ["base_chapter_version_id", "expected_spec_revision", "expected_working_copy_revision", "selection", "instruction", "source_ids"],
      "additionalProperties": false
    },
    "AuthorizedSourceSnapshot": {
      "type": "object",
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "asset_id": {"type": "string", "minLength": 1},
        "asset_revision": {"type": "integer", "minimum": 1},
        "locator": {"type": "string", "minLength": 1},
        "quoted_text_hash": {"type": "string", "minLength": 1},
        "authorized_at": {"type": "string", "format": "date-time"}
      },
      "required": ["source_id", "asset_id", "asset_revision", "locator", "quoted_text_hash", "authorized_at"],
      "additionalProperties": false
    },
    "RewriteCandidate": {
      "type": "object",
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1},
        "chapter_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["queued", "ready", "failed", "stale"]},
        "run_mode": {"enum": ["mock", "real_api_fake_model", "real"], "description": "服务端记录的实际运行模式；不可由客户端声明"},
        "base_chapter_version_id": {"type": ["string", "null"]},
        "spec_revision": {"type": "integer", "minimum": 0},
        "working_copy_revision": {"type": "integer", "minimum": 1},
        "selection": {"$ref": "#/schemas/Selection"},
        "replacement_markdown": {"type": ["string", "null"]},
        "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "authorized_sources": {"type": "array", "items": {"$ref": "#/schemas/AuthorizedSourceSnapshot"}, "uniqueItems": true},
        "review_items": {"type": "array", "items": {"$ref": "#/schemas/ReviewItem"}},
        "error_code": {"type": ["string", "null"]}
      },
      "required": ["candidate_id", "project_id", "chapter_id", "status", "run_mode", "base_chapter_version_id", "spec_revision", "working_copy_revision", "selection", "replacement_markdown", "source_ids", "authorized_sources", "review_items", "error_code"],
      "additionalProperties": false
    },
    "ApplySelectedRewriteRequest": {
      "type": "object",
      "properties": {
        "expected_spec_revision": {"type": "integer", "minimum": 0},
        "expected_working_copy_revision": {"type": "integer", "minimum": 1},
        "base_chapter_version_id": {"type": ["string", "null"]}
      },
      "required": ["expected_spec_revision", "expected_working_copy_revision", "base_chapter_version_id"],
      "additionalProperties": false
    },
    "CommitWorkingCopyRequest": {
      "type": "object",
      "properties": {
        "expected_spec_revision": {"type": "integer", "minimum": 0},
        "expected_working_copy_revision": {"type": "integer", "minimum": 1},
        "expected_chapter_version_id": {"type": ["string", "null"]}
      },
      "required": ["expected_spec_revision", "expected_working_copy_revision", "expected_chapter_version_id"],
      "additionalProperties": false
    },
    "CommittedChapterVersion": {
      "type": "object",
      "properties": {
        "chapter_version_id": {"type": "string", "minLength": 1},
        "parent_chapter_version_id": {"type": ["string", "null"]},
        "committed_working_copy_revision": {"type": "integer", "minimum": 1},
        "next_working_copy_revision": {"type": "integer", "minimum": 2},
        "spec_revision": {"type": "integer", "minimum": 0},
        "body_markdown": {"type": "string"},
        "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "review_items": {"type": "array", "items": {"$ref": "#/schemas/ReviewItem"}}
      },
      "required": ["chapter_version_id", "parent_chapter_version_id", "committed_working_copy_revision", "next_working_copy_revision", "spec_revision", "body_markdown", "source_ids", "review_items"],
      "additionalProperties": false
    },
    "ApiErrorResponse": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {"type": "string", "minLength": 1},
            "message": {"type": "string"},
            "retryable": {"type": "boolean"}
          },
          "required": ["code", "message", "retryable"],
          "additionalProperties": false
        },
        "request_id": {"type": "string", "minLength": 1}
      },
      "required": ["error", "request_id"],
      "additionalProperties": false
    }
  },
