{
  "contract_version": "0.5.0",
  "status": "design_static_only",
  "scenarios": [
    {
      "id": "F01",
      "name": "完整连续闭环",
      "mode": "real_api_fake_model_then_real_model",
      "specification_file": "workflow.json",
      "note": "逐步请求、响应变量、版本、两章保存与确认，以外部文件为准；尚未对真实provider执行。",
      "providers": [
        "evidence",
        "workspace",
        "delivery"
      ]
    },
    {
      "id": "F02",
      "name": "空资料不扩大范围",
      "starting_state": "S1",
      "setup": "项目无绑定资料；请求传空asset_ids。",
      "white_box_observation": {
        "id": "F02-WB-01",
        "classification": "white_box",
        "observer": [
          "go",
          "test",
          "./internal/lingdoc/generation",
          "-run",
          "^TestStartEmptyAssetScopeHasNoDownstreamEffects$",
          "-count=1",
          "-v"
        ],
        "zero_counters": [
          "input_resolver_calls",
          "repository_find_replay_calls",
          "repository_create_run_calls",
          "enqueue_calls",
          "model_generate_calls"
        ],
        "boundary": "依赖计数观察 Service.Start 的 guard 后缀；真实 HTTP 结果单独记录，不把白盒计数描述成真实进程的探针。"
      },
      "steps": [
        {
          "id": "F02-01",
          "operation_id": "startGeneration",
          "expected_http": 400,
          "assertion": "HTTP 端点以 invalid_request 拒绝空资料请求。",
          "actor": "u-owner",
          "request": {
            "path_params": {
              "projectId": "{{project.id}}"
            },
            "headers": {
              "Idempotency-Key": "f02-empty-assets-01"
            },
            "json": {
              "chapter_id": "{{chapter.question}}",
              "asset_ids": [],
              "instruction": "基于项目资料起草研究问题。",
              "expected_spec_revision": 1,
              "expected_chapter_version_id": null
            }
          },
          "response_example": "invalid_request",
          "checks": [
            {
              "path": "/error/code",
              "equals": "invalid_request",
              "intent": "空资料请求被参数校验拒绝。"
            }
          ]
        }
      ],
      "providers": [
        "evidence"
      ]
    },
    {
      "id": "F03",
      "name": "未就绪资料",
      "setup": "从 S3 读回一条已绑定但仍 processing 的资料；列表不得把它列为可用资料，检索预检拒绝它。",
      "starting_state": "S3",
      "steps": [
        {
          "id": "F03-01",
          "operation_id": "listAssets",
          "actor": "u-owner",
          "expected_http": 200,
          "request": {"path_params": {"projectId": "{{project.id}}"}, "headers": {}, "json": null},
          "checks": [{"path": "/data", "length": 0, "intent": "未就绪资料不出现在可用资料列表"}],
          "assertion": "确认未就绪绑定未被报告为可用资料。",
          "response_example": "empty"
        },
        {
          "id": "F03-02",
          "operation_id": "retrieveSources",
          "actor": "u-owner",
          "expected_http": 422,
          "request": {"path_params": {"projectId": "{{project.id}}"}, "headers": {"Idempotency-Key": "f03-not-ready-retrieval-0001"}, "json": {"query": "合成未就绪资料检索探针", "asset_ids": ["{{asset.k-notready}}"]}},
          "checks": [{"path": "/error/code", "equals": "asset_not_authorized", "intent": "检索拒绝尚未就绪的资料；具体原因错分另记为差异"}],
          "assertion": "检索预检拒绝未就绪资料，不把空解析结果当成证据；本场景只验证 retrieveSources。",
          "response_example": "asset_not_authorized"
        }
      ],
      "providers": [
        "evidence"
      ]
    },
    {
      "id": "F04",
      "name": "跨项目访问",
      "starting_state": "S5",
      "setup": "契约步骤 F04-01 检查项目存在性。真实驱动另用不同项目成员身份读取本次 F07 流程实际产生的候选和已验证导出；这两项补充观测记入运行报告，使用当次对象 ID。",
      "steps": [
        {
          "id": "F04-01",
          "operation_id": "getProject",
          "actor": "u-member",
          "expected_http": 404,
          "assertion": "非项目成员无法读取项目存在性。",
          "request": {
            "path_params": {
              "projectId": "{{project.id}}"
            }
          },
          "response_example": "not_found"
        }
      ],
      "providers": [
        "evidence",
        "workspace",
        "delivery"
      ]
    },
    {
      "id": "F05",
      "name": "两人同版本保存",
      "starting_state": "S2",
      "setup": "Owner 与协作者先后读取同一章节版本，再各自提交不同正文；先写入者成功，后写入者应收到明确的版本冲突，且不能覆盖先写入者。",
      "steps": [
        {
          "id": "F05-01",
          "operation_id": "listChapters",
          "actor": "u-owner",
          "expected_http": 200,
          "request": {"path_params": {"projectId": "{{project.id}}"}, "headers": {}, "json": null},
          "capture": {"f05.chapter_id": "/data/1/id", "f05.owner_version": "/data/1/current_version_id"},
          "assertion": "Owner 读取并留存开始写入前的章节版本。",
          "response_example": "success",
          "checks": [{"path": "/data/1/section_id", "equals": "question", "intent": "读取的是双方竞争保存的研究问题章节"}]
        },
        {
          "id": "F05-02",
          "operation_id": "listChapters",
          "actor": "u-member",
          "expected_http": 200,
          "request": {"path_params": {"projectId": "{{project.id}}"}, "headers": {}, "json": null},
          "capture": {"f05.member_version": "/data/1/current_version_id"},
          "assertion": "协作者在 Owner 写入前也读取并留存同一版本。",
          "response_example": "success",
          "checks": [{"path": "/data/1/current_version_id", "equals": "{{f05.owner_version}}", "intent": "两位调用者基于同一个章节版本"}]
        },
        {
          "id": "F05-03",
          "operation_id": "saveChapter",
          "actor": "u-owner",
          "expected_http": 201,
          "request": {
            "path_params": {"projectId": "{{project.id}}", "chapterId": "{{f05.chapter_id}}"},
            "headers": {"Idempotency-Key": "f05-owner-save-0001"},
            "json": {"expected_chapter_version_id": "{{f05.owner_version}}", "expected_spec_revision": 1,
                      "body_markdown": "Owner 写入的合成版本。", "source_ids": []}
          },
          "capture": {"f05.written_version": "/data/current_version_id", "f05.written_body": "/data/body_markdown"},
          "assertion": "基于读取到的当前版本，Owner 的首次写入成功并产生新版本。",
          "response_example": "success"
        },
        {
          "id": "F05-04",
          "operation_id": "saveChapter",
          "actor": "u-member",
          "expected_http": 409,
          "request": {
            "path_params": {"projectId": "{{project.id}}", "chapterId": "{{f05.chapter_id}}"},
            "headers": {"Idempotency-Key": "f05-member-save-0001"},
            "json": {"expected_chapter_version_id": "{{f05.member_version}}", "expected_spec_revision": 1,
                      "body_markdown": "协作者尝试写入的不同版本。", "source_ids": []}
          },
          "assertion": "后到的协作者写入必须因旧章节版本发生冲突，而不是被静默覆盖。",
          "response_exa