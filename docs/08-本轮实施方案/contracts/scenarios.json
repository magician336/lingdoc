        {
          "operation_id": "startGeneration",
          "expected_http": 409,
          "assertion": "同键改instruction被拒绝；同样验证采纳和导出。",
          "response_example": "idempotency_conflict"
        }
      ],
      "providers": [
        "evidence",
        "workspace",
        "delivery"
      ]
