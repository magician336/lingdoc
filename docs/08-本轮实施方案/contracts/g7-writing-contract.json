        "parent_version_id": {"type": ["string", "null"]},
        "spec_revision": {"type": "integer", "minimum": 0},
        "body_markdown": {"type": "string"},
        "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "review_items": {"type": "array", "items": {"$ref": "#/schemas/ReviewItem"}},
        "confirmation_valid": {"type": "boolean"},
        "created_at": {"type": "string", "format": "date-time"}
      },
      "required": ["id", "project_id", "chapter_id", "parent_version_id", "spec_revision", "body_markdown", "source_ids", "review_items", "confirmation_valid", "created_at"],
      "additionalProperties": false
    },
    "ChapterVersionList": {
      "type": "object",
      "properties": {"items": {"type": "array", "items": {"$ref": "#/schemas/ChapterVersion"}}},
      "required": ["items"],
      "additionalProperties": false
    },
    "RestoreWorkingCopyRequest": {
      "type": "object",
      "properties": {
        "chapter_version_id": {"type": "string", "minLength": 1},
        "expected_chapter_version_id": {"type": ["string", "null"]},
        "expected_spec_revision": {"type": "integer", "minimum": 0},
        "expected_working_copy_revision": {"type": "integer", "minimum": 1}
      },
      "required": ["chapter_version_id", "expected_chapter_version_id", "expected_spec_revision", "expected_working_copy_revision"],
      "additionalProperties": false
    },
    "Selection": {
