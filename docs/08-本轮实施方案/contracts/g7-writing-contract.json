        "working_copy_revision": {"type": "integer", "minimum": 1},
        "body_markdown": {"type": "string"},
        "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "review_items": {"type": "array", "items": {"$ref": "#/schemas/ReviewItem"}},
        "updated_at": {"type": "string", "format": "date-time"}
      },
      "required": ["project_id", "chapter_id", "base_chapter_version_id", "spec_revision", "working_copy_revision", "body_markdown", "source_ids", "review_items", "updated_at"],
      "additionalProperties": false
