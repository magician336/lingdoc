{
  "contract_version": "1.0.0",
  "status": "implementation_in_progress_runtime_unverified",
  "baseline_main_sha": "e328c56bb47d22e348850589e4dc9ddbad8d265e",
  "scope": "G7-01 contract freeze for working copy, selected rewrite, local apply, and explicit immutable-version commit",
  "source_format": "body_markdown with [[source:<source_id>]] markers",
  "selection_offsets": "zero-based UTF-16 code units; end exclusive; selected_text must exactly match the current work-copy range",
  "operation_contracts": [
    {
      "operation_id": "getWorkingCopy",
      "method": "GET",
      "path": "/projects/{projectId}/chapters/{chapterId}/working-copy",
      "response_schema": "WorkingCopy",
      "side_effect": "none",
      "authorization": [
        "current project read",
        "current authorization for every referenced source"
      ]
    },
    {
      "operation_id": "saveWorkingCopy",
      "method": "PUT",
      "path": "/projects/{projectId}/chapters/{chapterId}/working-copy",
      "request_schema": "SaveWorkingCopyRequest",
      "response_schema": "WorkingCopy",
      "requires_idempotency_key": true,
      "side_effect": "create a mutable work-copy checkpoint only; never create a ChapterVersion",
      "authorization": [
        "current project write",
        "recheck every referenced source before write and replay"
      ]
    },
    {
      "operation_id": "listChapterVersions",
      "method": "GET",
      "path": "/projects/{projectId}/chapters/{chapterId}/versions",
      "response_schema": "ChapterVersionList",
      "side_effect": "none",
      "authorization": [
        "current project read",
        "current authorization for every referenced source"
      ]
    },
    {
      "operation_id": "restoreWorkingCopy",
      "method": "POST",
      "path": "/projects/{projectId}/chapters/{chapterId}/working-copy/restore",
      "request_schema": "RestoreWorkingCopyRequest",
      "response_schema": "WorkingCopy",
      "requires_idempotency_key": true,
      "side_effect": "copy an immutable chapter version into the current working copy; do not create or alter a ChapterVersion",
      "authorization": [
        "current project write",
        "recheck every referenced source before restore and replay"
      ]
    },
    {
      "operation_id": "requestSelectedRewrite",
      "method": "POST",
      "path": "/projects/{projectId}/chapters/{chapterId}/rewrite-candidates",
      "request_schema": "SelectedRewriteRequest",
      "response_schema": "RewriteCandidate",
      "requires_idempotency_key": true,
      "side_effect": "create a candidate only; do not mutate the working copy or ChapterVersion",
      "authorization": [
        "current project write",
        "current authorization for every referenced source"
      ]
    },
    {
      "operation_id": "getSelectedRewrite",
      "method": "GET",
      "path": "/projects/{projectId}/rewrite-candidates/{candidateId}",
      "response_schema": "RewriteCandidate",
      "side_effect": "none",
      "authorization": [
        "current project read",
        "recheck candidate source authorization; revoke returns no candidate text"
      ]
    },
    {
      "operation_id": "applySelectedRewrite",
      "method": "POST",
      "path": "/projects/{projectId}/chapters/{chapterId}/rewrite-candidates/{candidateId}/apply",
      "request_schema": "ApplySelectedRewriteRequest",
      "response_schema": "WorkingCopy",
      "requires_idempotency_key": true,
      "side_effect": "replace only the bound selection in the working copy; never create a ChapterVersion",
      "authorization": [
        "current project write",
        "recheck every candidate source before apply and replay"
      ]
    },
    {
      "operation_id": "commitWorkingCopy",
      "method": "POST",
      "path": "/projects/{projectId}/chapters/{chapterId}/working-copy/commit",
      "request_schema": "CommitWorkingCopyRequest",
      "response_schema": "CommittedChapterVersion",
      "requires_idempotency_key": true,
      "side_effect": "create exactly one immutable ChapterVersion from the persisted current working-copy revision, atomically advance the work-copy base to that version, increment its revision, and stale prior candidates",
      "authorization": [
        "current project write",
        "recheck every referenced source before commit and replay"
      ]
    },
    {
      "operation_id": "listWritingActions",
      "method": "GET",
      "path": "/projects/{projectId}/writing-actions",
      "response_schema": "WritingActionDescription",
      "side_effect": "none",
      "authorization": [
        "current project read"
      ]
    },
    {
      "operation_id": "createReviewReport",
      "method": "POST",
      "path": "/projects/{projectId}/chapters/{chapterId}/review-reports",
      "request_schema": "ReviewReportRequest",
      "response_schema": "ReviewReport",
      "side_effect": "create a review report; the working copy is not changed",
      "authorization": [
        "current project write",
        "current authorization for every referenced source"
      ]
    },
    {
      "operation_id": "getReviewReport",
      "method": "GET",
      "path": "/projects/{projectId}/review-reports/{reportId}",
      "response_schema": "ReviewReport",
      "side_effect": "none",
      "authorization": [
        "current project read",
        "current authorization for every referenced source"
      ]
    },
    {
      "operation_id": "rejectReviewReport",
      "method": "POST",
      "path": "/projects/{projectId}/review-reports/{reportId}/reject",
      "response_schema": "ReviewReport",
      "side_effect": "mark the report rejected; the working copy is not changed",
      "authorization": [
        "current project write"
      ]
    },
    {
      "operation_id": "applyReview",
      "method": "POST",
      "path": "/projects/{projectId}/chapters/{chapterId}/review-reports/{reportId}/apply",
      "request_schema": "ApplyReviewRequest",
      "response_schema": "WorkingCopy",
      "side_effect": "apply the report's findings to the working copy; the body is not changed",
      "authorization": [
        "current project write",
        "current authorization for every referenced source"
      ]
    }
  ],
